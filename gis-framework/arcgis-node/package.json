{
  "name": "arcgis-node",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --coverage",
    "proto-gen": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js --outDir=generated ../src/main/proto/ArcGisJs.proto",
    "copy:core": "cpx \"node_modules/@arcgis/core/assets/**/*.*\" ./public/assets",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "@arcgis/core": "5.0.15",
    "@terraformer/arcgis": "2.1.2",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@types/node": "25.5.2",
    "@types/terraformer__arcgis": "2.0.5",
    "@vitest/coverage-v8": "4.1.3",
    "cpx2": "8.0.2",
    "eslint": "10.2.0",
    "eslint-config-prettier": "10.1.8",
    "express": "5.2.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.1",
    "vitest": "4.1.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
