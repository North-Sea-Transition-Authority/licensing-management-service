{
  "name": "arcgis-node",
  "type": "module",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --coverage",
    "proto-gen": "proto-loader-gen-types --longs=String --enums=String --defaults --oneofs --grpcLib=@grpc/grpc-js -I ../src/main/proto --outDir=generated ArcGisJs.proto",
    "copy:core": "cpx \"node_modules/@arcgis/core/assets/**/*.*\" ./public/assets",
    "setup": "run-p copy:core proto-gen",
    "lint": "cd .. && eslint arcgis-node",
    "lint:fix": "cd .. && eslint arcgis-node --fix"
  },
  "dependencies": {
    "@arcgis/core": "5.0.15",
    "@terraformer/arcgis": "2.1.2",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@grpc/grpc-js": "1.14.3",
    "@grpc/proto-loader": "0.8.0",
    "@types/express": "5.0.6",
    "@types/node": "25.5.2",
    "@types/terraformer__arcgis": "2.0.5",
    "@vitest/coverage-v8": "4.1.3",
    "cpx2": "8.0.2",
    "express": "5.2.1",
    "npm-run-all2": "^9.0.2",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.3"
  }
}
