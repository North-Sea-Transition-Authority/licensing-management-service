{
  "name": "gis-framework",
  "private": true,
  "scripts": {
    "proto:java": "gradlew clean extractIncludeProto extractProto generateProto",
    "build:arcgis": "cd arcgis-node && npm install && npm run setup",
    "build-all": "npm-run-all proto:java --parallel build build:arcgis",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "cd .. && husky gis-framework/.husky",
    "type-check": "vue-tsc --noEmit",
    "watch": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vitest:visual": "vitest run --config vitest.browser.visual.config.ts",
    "test:vitest:visual:update": "vitest run --config vitest.browser.visual.config.ts --update"
  },
  "dependencies": {
    "geodesy": "2.4.0",
    "ol": "10.9.0",
    "ol-contextmenu": "5.5.0",
    "ol-ext": "4.0.38",
    "proj4": "2.20.8",
    "vue3-openlayers": "12.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@testing-library/vue": "8.1.0",
    "@types/geodesy": "2.2.8",
    "@vitejs/plugin-vue": "6.0.6",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/ui": "4.1.8",
    "eslint": "10.3.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "msw": "2.14.6",
    "npm-run-all2": "^9.0.2",
    "pixelmatch": "7.2.0",
    "playwright": "1.60.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vitest-browser-vue": "2.1.0",
    "vue": "3.5.32",
    "vue-tsc": "3.2.8"
  }
}
