{
  "name": "gis-framework",
  "private": true,
  "scripts": {
    "build-all": "gradlew clean && gradlew extractIncludeProto && gradlew extractProto && gradlew generateProto && npm run build && cd arcgis-node && npm install && npm run copy:core && npm run proto-gen && cd ..",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "cd .. && husky gis-framework/.husky",
    "type-check": "vue-tsc --noEmit",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "ol": "10.9.0",
    "ol-contextmenu": "5.5.0",
    "ol-ext": "4.0.38",
    "proj4": "2.20.8",
    "vue3-openlayers": "12.2.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.0.0",
    "@vitejs/plugin-vue": "6.0.6",
    "eslint": "10.3.0",
    "husky": "9.1.7",
    "typescript": "6.0.3",
    "vite": "8.0.12",
    "vue": "3.5.32",
    "vue-tsc": "3.2.8"
  }
}
